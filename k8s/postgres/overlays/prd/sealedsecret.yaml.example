# Gerado a partir de secret.yaml com kubeseal.
---
apiVersion: bitnami.com/v1alpha1
kind: SealedSecret
metadata:
  name: postgres-credentials
  namespace: bot-discord-db
spec:
  encryptedData:
    POSTGRES_USER: REPLACE_WITH_KUBESEAL_OUTPUT
    POSTGRES_PASSWORD: REPLACE_WITH_KUBESEAL_OUTPUT
    POSTGRES_DB: REPLACE_WITH_KUBESEAL_OUTPUT
    username: REPLACE_WITH_KUBESEAL_OUTPUT
    password: REPLACE_WITH_KUBESEAL_OUTPUT
    database: REPLACE_WITH_KUBESEAL_OUTPUT
  template:
    metadata:
      name: postgres-credentials
      namespace: bot-discord-db
      annotations:
        argocd.argoproj.io/sync-wave: "0"
    type: Opaque
