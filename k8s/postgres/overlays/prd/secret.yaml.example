# Generate with:
# kubeseal --format yaml --cert k8s/prd-pub.pem < \
#   k8s/postgres/overlays/prd/secret.yaml > \
#   k8s/postgres/overlays/prd/sealedsecret.yaml
---
apiVersion: v1
kind: Secret
metadata:
  name: postgres-credentials
  namespace: bot-discord-db
  annotations:
    argocd.argoproj.io/sync-wave: "0"
type: Opaque
stringData:
  POSTGRES_USER: music
  POSTGRES_PASSWORD: troque-esta-senha
  POSTGRES_DB: music
  # Usado pelo ExternalSecret do bot/web para montar DATABASE_URL
  username: music
  password: troque-esta-senha
  database: music
