# Generate with:
# kubeseal --format yaml --cert k8s/prd-pub.pem < \
#   k8s/apps/bot-discord/lavalink/overlays/prd/secret.yaml > \
#   k8s/apps/bot-discord/lavalink/overlays/prd/sealedsecret.yaml
#
# A senha em lavalink.server.password DEVE ser a mesma de
# bot-discord-app-config.LAVALINK_PASSWORD.
---
apiVersion: v1
kind: Secret
metadata:
  name: lavalink-config
  namespace: bot-discord
  annotations:
    argocd.argoproj.io/sync-wave: "0"
type: Opaque
stringData:
  application.yml: |
    server:
      port: 2333
      address: 0.0.0.0

    lavalink:
      plugins:
        - dependency: "dev.lavalink.youtube:youtube-plugin:1.18.2"
          snapshot: false
      server:
        password: "troque-esta-senha"
        sources:
          youtube: false
          bandcamp: true
          soundcloud: true
          twitch: true
          vimeo: true
          http: true
          local: false
        bufferDurationMs: 400
        frameBufferDurationMs: 5000
        trackStuckThresholdMs: 10000
        youtubePlaylistLoadLimit: 6
        playerUpdateInterval: 5
        youtubeSearchEnabled: true
        soundcloudSearchEnabled: true
        gc-warnings: true

    plugins:
      youtube:
        enabled: true
        allowSearch: true
        allowDirectVideoIds: true
        allowDirectPlaylistIds: true
        clients:
          - MUSIC
          - ANDROID_VR
          - WEB
          - WEBEMBEDDED

    logging:
      level:
        root: INFO
        lavalink: INFO
