# Gerado a partir de um Secret em claro com kubeseal.
# Nunca commite o Secret em texto claro — só este SealedSecret.
---
apiVersion: bitnami.com/v1alpha1
kind: SealedSecret
metadata:
  name: bot-discord-spotify
  namespace: bot-discord
spec:
  encryptedData:
    SPOTIFY_CLIENT_ID: REPLACE_WITH_KUBESEAL_OUTPUT
    SPOTIFY_CLIENT_SECRET: REPLACE_WITH_KUBESEAL_OUTPUT
  template:
    metadata:
      name: bot-discord-spotify
      namespace: bot-discord
      annotations:
        argocd.argoproj.io/sync-wave: "0"
    type: Opaque
