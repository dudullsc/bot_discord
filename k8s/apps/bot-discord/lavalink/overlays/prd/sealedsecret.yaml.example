# Gerado a partir de secret.yaml com kubeseal.
---
apiVersion: bitnami.com/v1alpha1
kind: SealedSecret
metadata:
  name: lavalink-config
  namespace: bot-discord
spec:
  encryptedData:
    application.yml: REPLACE_WITH_KUBESEAL_OUTPUT
  template:
    metadata:
      name: lavalink-config
      namespace: bot-discord
      annotations:
        argocd.argoproj.io/sync-wave: "0"
    type: Opaque
