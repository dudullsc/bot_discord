# Pull secret GHCR (ghcr.io/dudullsc/...).
#
# kubectl create secret docker-registry ghcr-pull-secret \
#   -n bot-discord \
#   --docker-server=ghcr.io \
#   --docker-username=dudullsc \
#   --docker-password="$GHCR_TOKEN" \
#   --dry-run=client -o yaml > \
#   k8s/apps/bot-discord/bot/overlays/prd/ghcr-pull-secret.yaml
#
# kubeseal --format yaml --cert k8s/prd-pub.pem \
#   < k8s/apps/bot-discord/bot/overlays/prd/ghcr-pull-secret.yaml \
#   > k8s/apps/bot-discord/bot/overlays/prd/ghcr-pull-sealedsecret.yaml
---
apiVersion: v1
kind: Secret
metadata:
  name: ghcr-pull-secret
  namespace: bot-discord
type: kubernetes.io/dockerconfigjson
stringData:
  .dockerconfigjson: |
    {"auths":{"ghcr.io":{"username":"dudullsc","password":"REPLACE_WITH_PAT","auth":"REPLACE_BASE64"}}}
