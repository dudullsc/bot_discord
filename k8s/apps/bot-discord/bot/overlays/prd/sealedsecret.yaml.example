# Gerado a partir de secret.yaml com kubeseal.
# Depois de selar, copie para sealedsecret.yaml.
---
apiVersion: bitnami.com/v1alpha1
kind: SealedSecret
metadata:
  name: bot-discord-app-config
  namespace: bot-discord
spec:
  encryptedData:
    DISCORD_TOKEN: REPLACE_WITH_KUBESEAL_OUTPUT
    DISCORD_CLIENT_ID: REPLACE_WITH_KUBESEAL_OUTPUT
    DISCORD_GUILD_ID: REPLACE_WITH_KUBESEAL_OUTPUT
    LAVALINK_PASSWORD: REPLACE_WITH_KUBESEAL_OUTPUT
    YOUTUBE_OAUTH_REFRESH_TOKEN: REPLACE_WITH_KUBESEAL_OUTPUT
    DEEZER_ARL: REPLACE_WITH_KUBESEAL_OUTPUT
  template:
    metadata:
      name: bot-discord-app-config
      namespace: bot-discord
    type: Opaque
